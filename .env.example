# CodeGraph AI — environment configuration.
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit the real .env file — see .gitignore and SECURITY.md.
#
# Every variable below is annotated [required] or [optional], with its
# default if any. Nothing in application code hardcodes a value that
# differs between environments — this file (or real environment
# variables) is the only place that should change between a laptop, a
# teammate's machine, and a server. See docs/HANDOVER.md for the full
# setup walkthrough and docs/LOCAL_LLM_SETUP.md specifically for the LLM
# section below.

# =============================================================================
# APPLICATION
# =============================================================================

# [optional, default: development] "development" | "production" — only
# affects log formatting today, not behavior.
APP_ENV=development
# [optional, default: 0.0.0.0]
APP_HOST=0.0.0.0
# [optional, default: 8000] Port the backend listens on.
APP_PORT=8000
# [optional, default: INFO] DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# [optional, default: http://localhost:5173] Comma-separated browser
# origins allowed to call the API. Never set this to "*" together with
# credentials — see SECURITY.md.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Authentication signing secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
AUTH_TOKEN_EXPIRY_HOURS=12

# =============================================================================
# DATABASE (application metadata — repositories, analysis runs, etc.)
# =============================================================================

# [optional, default: sqlite:///./data/codegraph.db] SQLite is the
# supported default. A future PostgreSQL migration path exists (schema is
# kept compatible) — see DATA_MODEL.md — but is not required for local use.
DATABASE_URL=sqlite:///./data/codegraph.db
# PostgreSQL example (not required):
# DATABASE_URL=postgresql+psycopg://codegraph:changeme@localhost:5432/codegraph

# =============================================================================
# WORKSPACE (where ingested repository content lives on disk)
# =============================================================================

# [optional, default: ./data/allowed_repos] Base directory that
# `local_path` repository ingestion is restricted to — see SECURITY.md.
INGESTION_ALLOWED_BASE_DIR=./data/allowed_repos
# [optional, default: ./data/workspaces] Per-repository scratch space for
# ZIP extraction / git clones. Must be a writable path — see
# docs/TROUBLESHOOTING.md if it isn't.
INGESTION_WORKSPACE_DIR=./data/workspaces
# [optional, default: 120]
INGESTION_CLONE_TIMEOUT_SECONDS=120
# [optional, default: 500] Cap on extracted/cloned repository content.
INGESTION_MAX_REPO_SIZE_MB=500
# [optional, default: 50] Cap on the raw uploaded .zip file itself.
INGESTION_MAX_UPLOAD_SIZE_MB=50

# --- Remote repository URL cloning (POST /api/v1/repositories/clone) ---
#
# "Paste a GitHub/GitLab URL and the backend clones it" — a narrower,
# separately-configurable safety layer on top of the general git-clone
# support above (INGESTION_CLONE_TIMEOUT_SECONDS / INGESTION_MAX_REPO_SIZE_MB
# still apply to the clone itself). Public HTTPS only; private
# repositories and SSH URLs (ssh://, git@host:path) are never supported,
# regardless of this section — see SECURITY.md "Repository acquisition
# safety" and app/ingestion/git_clone.py.
#
# SECURITY WARNING: this lets the backend make outbound HTTP(S)-adjacent
# requests to a caller-supplied host (bounded by the allow-list below) —
# a classic SSRF-shaped surface. This project has no authentication (see
# SECURITY.md) — do not expose this endpoint on a shared/public network
# without adding auth and rate limiting first, even with the allow-list
# in place.
#
# [optional, default: true] Kill switch for the whole feature. Set false
# to disable URL-based cloning entirely (ZIP upload / local path are
# unaffected) — the endpoint then returns a clear GIT_CLONING_DISABLED
# error instead of attempting anything.
REPO_URL_CLONE_ENABLED=true
# [optional, default: github.com,gitlab.com] Comma-separated exact
# hostnames (case-insensitive) allowed to be cloned from. A URL on any
# other host is rejected before git is ever invoked. Widen only if you
# understand the risk above.
REPO_CLONE_ALLOWED_HOSTS=github.com,gitlab.com
# [optional, default: 1] Shallow-clone depth (git clone --depth). 1 is
# enough for parsing/indexing — full history is never needed.
REPO_CLONE_DEPTH=1

# =============================================================================
# NEO4J (knowledge graph — required for graph features, impact analysis,
# and graph-mode retrieval; the app still runs in a degraded mode without
# it, see ARCHITECTURE.md "Graceful degradation")
# =============================================================================

# [required for graph features] Bolt URI the BACKEND PROCESS connects
# with. This repo's docker-compose.yml publishes Neo4j's Bolt port on a
# remapped HOST port, 7688 (not the Neo4j-standard 7687), because 7687 is
# already used by another local container on some machines — see
# docker-compose.yml's `neo4j` service `ports:` mapping ("7688:7687") and
# docs/TROUBLESHOOTING.md "Port conflict".
#
# - Backend running on your HOST (outside Docker — `make run-backend` /
#   `python scripts/*.py`) and Neo4j started via this repo's
#   `docker compose up -d neo4j`:
#     NEO4J_URI=bolt://localhost:7688
# - Backend running INSIDE Docker Compose (the `backend` service):
#   docker-compose.yml overrides this automatically to the
#   container-to-container hostname/port, bolt://neo4j:7687 — you never
#   need to set that yourself, and changing the value here has no effect
#   on the containerized backend.
#
# Default below (bolt://localhost:7688) is for the common case: host-run
# backend/scripts talking to Neo4j started by this repo's Docker Compose.
NEO4J_URI=bolt://localhost:7688
# [required, default: neo4j]
NEO4J_USERNAME=neo4j
# [required, default: changeme] Also sets the Neo4j container's own admin
# password via docker-compose.yml's NEO4J_AUTH — change this before any
# real/shared use.
NEO4J_PASSWORD=changeme
# [optional, default: neo4j] Database name within the Neo4j instance.
NEO4J_DATABASE=neo4j
# [optional, default: 10]
NEO4J_CONNECTION_TIMEOUT_SECONDS=10
# [optional, default: 50]
NEO4J_MAX_CONNECTION_POOL_SIZE=50
# Fail-fast settings (see backend/app/graph/neo4j_client.py and
# backend/app/core/dependencies/circuit_breaker.py) — bound a single
# call's driver-level retry loop and open a circuit breaker after
# repeated failures, so a Neo4j outage fails fast instead of every
# request waiting ~30-55s.
# [optional, default: 3]
NEO4J_OPERATION_TIMEOUT_SECONDS=3
# [optional, default: 3]
NEO4J_CIRCUIT_FAILURE_THRESHOLD=3
# [optional, default: 30]
NEO4J_CIRCUIT_COOLDOWN_SECONDS=30

# Graph query bounds (see ARCHITECTURE.md; all bounded-traversal API
# endpoints enforce these limits) — safe to leave at defaults.
GRAPH_DEFAULT_TRAVERSAL_DEPTH=1
GRAPH_MAX_TRAVERSAL_DEPTH=5
GRAPH_MAX_NODES=500
GRAPH_MAX_RELATIONSHIPS=1000
GRAPH_SYMBOL_SEARCH_DEFAULT_LIMIT=20
GRAPH_SYMBOL_SEARCH_MAX_LIMIT=100

# =============================================================================
# CHROMA (vector store — semantic code search)
# =============================================================================

# [optional, default: ./data/chroma] Embedded/persistent mode — a local
# directory, not a separate service (see ARCHITECTURE.md "Deployment view").
CHROMA_PERSIST_DIRECTORY=./data/chroma
# [optional, default: codegraph] Prefixed onto a sanitized repository_id
# to form each collection name — never a raw repository name.
CHROMA_COLLECTION_PREFIX=codegraph
# [optional] Only set these if running Chroma as a standalone server
# instead of the default embedded mode:
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# =============================================================================
# EMBEDDINGS (semantic-search representation — separate from the LLM
# below: this turns code into vectors for retrieval; the LLM turns
# retrieved evidence into a natural-language answer. Downloading an LLM
# does not give you an embedding model, and vice versa. See
# docs/LOCAL_LLM_SETUP.md.)
# =============================================================================

# [optional, default: sentence_transformers] Runs fully locally — no
# repository source code is ever sent to an external API with this
# default (see SECURITY.md).
EMBEDDING_PROVIDER=sentence_transformers
# [optional, default: sentence-transformers/all-MiniLM-L6-v2] Any
# sentence-transformers-compatible model id works. The default is a
# small (~90MB), widely-cached, 384-dimensional model with no custom Hub
# code, so it needs no EMBEDDING_TRUST_REMOTE_CODE opt-in and loads the
# same way on every machine — chosen as the transfer-ready default for
# that reason. For higher-quality, code-aware retrieval at the cost of a
# larger download and an explicit trust_remote_code opt-in, try
# jinaai/jina-embeddings-v2-base-code (~320MB, 768-dim) — see
# EMBEDDING_TRUST_REMOTE_CODE below and docs/TROUBLESHOOTING.md
# "trust_remote_code problem" before switching to it.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# [optional, default: cpu] "cpu" | "cuda" | "mps" — set to "cuda" if you
# have an NVIDIA GPU available for faster indexing.
EMBEDDING_DEVICE=cpu
# [optional, default: 16]
EMBEDDING_BATCH_SIZE=16
# [optional, default: true]
EMBEDDING_NORMALIZE=true
# [optional, default: 4096]
EMBEDDING_MAX_SEQUENCE_LENGTH=4096
# [required if EMBEDDING_MODEL_NAME needs it, default: false] See
# EMBEDDING_MODEL_NAME above — must be explicitly opted into.
EMBEDDING_TRUST_REMOTE_CODE=false
# [optional] Only read by a possible future OpenAI-compatible/Ollama
# embedding provider — unused by the default sentence_transformers
# provider, which never calls out to any API.
EMBEDDING_API_KEY=
# EMBEDDING_API_BASE_URL=

# Vector retrieval bounds (see backend/app/indexing/retrieval_service.py)
# — safe to leave at defaults.
VECTOR_DEFAULT_TOP_K=8
VECTOR_MAX_TOP_K=30
VECTOR_MIN_SCORE=0.0

# Syntax-aware chunking (see backend/app/indexing/chunker.py) — safe to
# leave at defaults.
CODE_CHUNK_MAX_CHARACTERS=4000
CODE_CHUNK_MAX_LINES=200
CODE_CHUNK_CONTEXT_LINES=3
INDEXING_BATCH_SIZE=32

# =============================================================================
# LLM (answer synthesis and impact-summary generation only — never a
# source of code-relationship facts, see AGENTS.md rule 2. Two provider
# families are supported: a cloud API ("anthropic") or any local/
# self-hosted OpenAI-compatible server ("openai_compatible", with
# "lmstudio" as a documented, identical alias) — see
# backend/app/rag/llm_provider.py. No third client exists for LM Studio
# specifically; it is just an OpenAI-compatible endpoint.)
# =============================================================================

# [required] "anthropic" | "openai_compatible" | "lmstudio"
# ("lmstudio" behaves identically to "openai_compatible" — see above).
LLM_PROVIDER=anthropic
# [required] The exact model identifier for the chosen provider —
# Anthropic model name (e.g. claude-sonnet-5), or the model id LM
# Studio/your OpenAI-compatible server is currently serving (see LM
# STUDIO section below for how to find this).
LLM_MODEL=claude-sonnet-5
# [required for "anthropic"; ignored for "openai_compatible"/"lmstudio",
# where any non-empty value works, e.g. "lm-studio"]
LLM_API_KEY=changeme
# [required for "openai_compatible"/"lmstudio"; ignored for "anthropic"]
# See the LM STUDIO section immediately below for the two real values
# this needs depending on how the backend itself is running.
# LLM_BASE_URL=
# [optional, default: 0.2] Low by default — grounded answers should be
# conservative, not creative.
LLM_TEMPERATURE=0.2
# [optional, default: 1024]
LLM_MAX_OUTPUT_TOKENS=1024
# [optional, default: 30]
LLM_TIMEOUT_SECONDS=30
# [optional, default: 2]
LLM_MAX_RETRIES=2
# [optional, default: 2.0] How long GET /api/v1/health/ready will wait when
# checking an "openai_compatible"/"lmstudio" server's connectivity — kept
# short so a stopped local LLM never makes readiness slow. Not used for
# "anthropic" (that check never makes a live network call — see
# backend/app/core/dependencies/status_service.py's check_llm docstring).
LLM_HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# -----------------------------------------------------------------------
# LM STUDIO — a first-class local LLM option. See docs/LOCAL_LLM_SETUP.md
# for installing LM Studio, downloading/loading a model, and finding its
# served model id. This section only matters when LLM_PROVIDER is
# "openai_compatible" or "lmstudio".
# -----------------------------------------------------------------------
#
# LLM_PROVIDER=lmstudio
#
# Backend running directly on your host (not Docker):
# LLM_BASE_URL=http://localhost:1234/v1
#
# Backend running inside Docker Desktop (Mac/Windows), talking to LM
# Studio running on the host — Docker Desktop resolves this hostname to
# the host machine automatically:
# LLM_BASE_URL=http://host.docker.internal:1234/v1
#
# Backend running inside Docker on Linux — host.docker.internal is not
# resolved by default there; docker-compose.yml already adds the
# required `extra_hosts: host.docker.internal:host-gateway` for the
# backend service, so the same URL above works on Linux too as long as
# you're using the provided docker-compose.yml.
#
# Must exactly match a model currently loaded in LM Studio's "Local
# Server" tab — copy the model id shown there, or GET {LLM_BASE_URL}/models.
# LLM_MODEL=
#
# LM Studio ignores the API key's value but some clients refuse to send
# an empty one — any non-empty placeholder works. Never put a real cloud
# API key here.
# LLM_API_KEY=lm-studio

# -----------------------------------------------------------------------
# DEEPSEEK (or any other cloud provider exposing an OpenAI-compatible
# chat-completions API) — not a separate code path, just another
# "openai_compatible" endpoint (see backend/app/rag/llm_provider.py — the
# same ChatOpenAI client LM Studio uses above, just pointed at a real
# cloud base_url). Useful as a much cheaper cloud alternative to
# LLM_PROVIDER=anthropic when you still want a hosted model rather than
# running one locally via LM Studio. Used only for LLM answer generation
# and impact-summary writing — embeddings stay on the local
# sentence_transformers provider above regardless of which LLM you pick.
# -----------------------------------------------------------------------
#
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
#
#
# A real DeepSeek API key is required here — never commit it. Verify
# the current base URL/model id against DeepSeek's own API documentation
# before relying on this, as cloud providers do change these over time:
# LLM_API_KEY=sk-a746f0b51eca45a984840e7d9e351439
#
# For "openai_compatible" providers, the readiness check
# (LLM_HEALTH_CHECK_TIMEOUT_SECONDS above) may call GET
# {LLM_BASE_URL}/models if the provider exposes that endpoint, to confirm
# LLM_MODEL is actually being served (reporting
# `configured_model_not_served` if not). Not every OpenAI-compatible
# provider implements `/models` the same way — behavior can vary by
# provider — so treat `python scripts/check_llm.py` (a real generation
# call) or the app's own readiness output as the final word, not this
# comment. Structured-output reliability (citation-marker following)
# also depends on the model's own tool-calling support, the same caveat
# as any other "openai_compatible" model — see
# docs/LOCAL_LLM_SETUP.md's "Choosing a model" section for the general
# idea, even though DeepSeek itself isn't local.

# =============================================================================
# RETRIEVAL (hybrid graph/vector retrieval and query analysis — see
# backend/app/rag/)
# =============================================================================

# [optional, default: hybrid] heuristic | llm | hybrid — the deterministic
# analyzer always runs and is always the fallback; this only controls the
# optional LLM-assisted strategy.
QUERY_ANALYZER_MODE=hybrid
# [optional, default: false] Off by default: query analysis works fully
# without an LLM. Turning this on uses the LLM configured above for
# question classification too (not just answer generation).
QUERY_ANALYZER_LLM_ENABLED=false
# [optional, default: 10]
QUERY_ANALYZER_TIMEOUT_SECONDS=10

ANSWER_MIN_EVIDENCE_RELEVANCE=0.15
ANSWER_HIGH_CONFIDENCE_THRESHOLD=0.7
ANSWER_MEDIUM_CONFIDENCE_THRESHOLD=0.4
ANSWER_MAX_CITATIONS=8
CONVERSATION_MAX_TURNS=10

RAG_SYMBOL_CANDIDATE_LIMIT=5
HYBRID_VECTOR_WEIGHT=0.45
HYBRID_EXACT_WEIGHT=0.25
HYBRID_GRAPH_WEIGHT=0.20
HYBRID_INTENT_WEIGHT=0.10
RAG_MAX_CONTEXT_CHARACTERS=12000
RAG_MAX_EVIDENCE_ITEMS=20
RAG_MAX_EVIDENCE_PER_FILE=4
RAG_MAX_GRAPH_EVIDENCE=10
RAG_MAX_VECTOR_EVIDENCE=10

# =============================================================================
# IMPACT (deterministic change-impact-analysis engine — see backend/app/impact/)
# =============================================================================

# Legacy: only used by app/rag/retrieval_planner.py's graph-depth
# suggestion for IMPACT_ANALYSIS-intent questions. NOT used by the
# deterministic impact-analysis engine itself — see IMPACT_* below.
IMPACT_ANALYSIS_DEFAULT_MAX_DEPTH=3

IMPACT_DEFAULT_DEPTH=2
IMPACT_MAX_DEPTH=5
IMPACT_DEFAULT_MAX_NODES=200
IMPACT_MAX_NODES=1000
IMPACT_MAX_PATHS=100

# Structural risk-score weights — sum to 100. Initial, UNTUNED heuristics;
# never presented as a probability of failure (see the impact-analysis
# task's "Risk scoring").
IMPACT_WEIGHT_DIRECT_CALLERS=15
IMPACT_WEIGHT_TRANSITIVE_DEPENDENTS=15
IMPACT_WEIGHT_AFFECTED_FILES=10
IMPACT_WEIGHT_API_EXPOSURE=20
IMPACT_WEIGHT_CROSS_MODULE=10
IMPACT_WEIGHT_EXTERNAL_DEPENDENCY=5
IMPACT_WEIGHT_INHERITANCE=10
IMPACT_WEIGHT_CENTRALITY=10
IMPACT_WEIGHT_TEST_SIGNAL=5

# Reference counts each signal's raw count is normalized against
# (normalized = min(raw / reference, 1.0)) — also untuned heuristics.
IMPACT_REFERENCE_DIRECT_CALLERS=5
IMPACT_REFERENCE_TRANSITIVE_DEPENDENTS=15
IMPACT_REFERENCE_AFFECTED_FILES=8
IMPACT_REFERENCE_API_ENDPOINTS=2
IMPACT_REFERENCE_CROSS_MODULE=5
IMPACT_REFERENCE_EXTERNAL_DEPENDENCIES=3
IMPACT_REFERENCE_INHERITANCE=3
IMPACT_REFERENCE_CENTRALITY=10

# Risk-level thresholds — score >= threshold maps to that level or higher.
IMPACT_RISK_MEDIUM_THRESHOLD=25
IMPACT_RISK_HIGH_THRESHOLD=50
IMPACT_RISK_CRITICAL_THRESHOLD=75

# =============================================================================
# CORS — see APPLICATION section above (CORS_ALLOWED_ORIGINS). Kept as one
# setting, listed there since it's a single application-level concern.
# =============================================================================

# =============================================================================
# FRONTEND (read by frontend/.env, not this file — see frontend/.env.example)
# =============================================================================
# VITE_API_BASE_URL=http://localhost:8000
